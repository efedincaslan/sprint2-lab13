pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('starter') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('starter') {
                    sh 'mvn test'
                }
            }
        }

        stage('Security Scan') {
            steps {
                dir('starter') {
                    sh 'mvn org.owasp:dependency-check-maven:check'
                }
            }
        }

        stage('Package') {
            steps {
                dir('starter') {
                    sh 'mvn package -DskipTests'
                }
            }
        }
    }

    post {
        always {
            junit 'starter/target/surefire-reports/*.xml'
        }

        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed.'
        }
    }
}
